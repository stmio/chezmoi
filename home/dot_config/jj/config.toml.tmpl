#:schema https://docs.jj-vcs.dev/latest/config-schema.json

[user]
name = "{{ .identity.name }}"
email = "{{ .identity.email }}"

[signing]
behavior = "drop"
backend = "ssh"
key = "{{ .identity.signingKey }}"
backends.ssh.program = "{{ .identity.opSshSign }}"
backends.ssh.allowed-signers = "{{ .chezmoi.homeDir }}/.config/git/allowed_signers"

[revsets]
git-sign-on-push = "~signed() & mine()"

[ui]
default-command = "log"
editor = "nvim"

[aliases]
lg = ["log", "-r", "all()"]
init = ["git", "init"]

