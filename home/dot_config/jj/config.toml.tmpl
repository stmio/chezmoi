#:schema https://docs.jj-vcs.dev/latest/config-schema.json

[user]
name = "{{ .identity.name }}"
email = "{{ .identity.email }}"

[signing]
behavior = "drop"
backend = "ssh"
key = "{{ .identity.signingKey }}"
backends.ssh.program = "{{ .identity.opSshSign }}"

[git]
sign-on-push = true

[ui]
default-command = "log"
editor = "nvim"

[aliases]
lg = ["log", "-r", "all()"]
init = ["git", "init"]

