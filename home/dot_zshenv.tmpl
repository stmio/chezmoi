[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# uv
export PATH="$HOME/.local/bin:$PATH"

# The 1Password app's SSH agent, via a symlink
export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
{{- if eq .machine "mini" }}

# Claude Code and remote logins can't approve 1Password prompts: use the Homelab keys
if [[ -n $CLAUDECODE || -n $SSH_CONNECTION ]]; then
  export SSH_AUTH_SOCK="$HOME/.ssh/homelab-agent.sock"
  ssh-add -l >/dev/null 2>&1 || "$HOME/.local/bin/homelab-ssh-agent"
  export GIT_CONFIG_COUNT=2
  export GIT_CONFIG_KEY_0=user.signingkey GIT_CONFIG_VALUE_0="$HOME/.ssh/mini-github.pub"
  export GIT_CONFIG_KEY_1=gpg.ssh.program GIT_CONFIG_VALUE_1=ssh-keygen
  export JJ_CONFIG="$HOME/.config/jj/config.toml:$HOME/.config/jj/homelab.toml"
fi
{{- end }}
